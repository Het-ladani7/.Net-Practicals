@model IEnumerable<InventoryManagementMVC.Models.Product>

@{
    ViewBag.Title = "Inventory";
}

<h2>Inventory Management</h2>

<p>
    @Html.ActionLink("Add New Product", "Create")
</p>

<table border="1" cellpadding="10" cellspacing="0">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Actions</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@p.Name</td>
            <td>@p.Quantity</td>
            <td>@p.Price</td>

            <td>
                @Html.ActionLink("Edit", "Edit", new { id = p.Id })

                @using (Html.BeginForm("Delete", "Inventory",
                    new { id = p.Id }, FormMethod.Post))
                {
                    <input type="submit"
                           value="Delete"
                           onclick="return confirm('Delete this product?');" />
                }
            </td>
        </tr>
    }
</table>
